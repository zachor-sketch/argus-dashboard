{"sequence":3,"previousHash":"9097f0c20f75311e9f831e218ba5552a5b0c2dbe621d911c62ee684a5d17b8d5","payload":{"schemaVersion":"argus.regulatory-history/1","id":"history-solyndra-2009","timestamp":"2026-09-04T16:52:47.182Z","evidenceCutoff":"2026-09-04T16:52:43.405Z","mode":"CURRENT_REVIEW","sources":[{"id":"solar","url":"https://www.energy.gov/ig/articles/special-report-11-0078-i","publishedAt":"2015-08-24T23:59:59.999Z","observedAt":"2026-09-04T16:52:43.405Z","precision":"DAY_END_BOUND","authority":"GOVERNMENT","category":"OUTCOME","edition":"DATED_DOCUMENT","locator":"Reviewed primary publication; curated factual excerpt, not original HTML fingerprint","text":"DOE Inspector General reports a $535m Solyndra loan guarantee in 2009, over $500m disbursed, and cessation/bankruptcy in September 2011. Government financing did not establish beneficiary survival.","contentHash":"a2e8e1653e8ee6e4b77a9898fc5bd71d0de0ebe50a4ce50e7a4d7c188d2e48b2"},{"id":"testimony","url":"https://www.energy.gov/congressional/articles/house-subcommittee-oversight-and-investigations","publishedAt":"2011-09-14T23:59:59.999Z","observedAt":"2026-09-04T16:52:43.405Z","precision":"DAY_END_BOUND","authority":"GOVERNMENT","category":"OUTCOME","edition":"DATED_DOCUMENT","locator":"Reviewed primary publication; curated factual excerpt, not original HTML fingerprint","text":"DOE testimony reports Solyndra revenue rose from $100m in 2009 to $140m in 2010; costs and competition undermined viability, with bankruptcy in early September 2011. More than $200m was paid to workers and suppliers from December 2010 to bankruptcy; supplier profits and identities are not established.","contentHash":"6f9d1539c0d1bdd2ed011f16637759eb48d64e6bb033cc823b39a559fa90fe41"}],"fields":{"historicalEvent":{"value":"Solyndra loan guarantee and manufacturing expansion","kind":"RESEARCH_INTERPRETATION","evidenceRefs":["solar","testimony"]},"jurisdiction":{"value":"United States","kind":"RESEARCH_INTERPRETATION","evidenceRefs":["solar","testimony"]},"date":{"value":"2009","kind":"RESEARCH_INTERPRETATION","evidenceRefs":["solar","testimony"]},"policyMechanism":{"value":"Government credit support funded photovoltaic manufacturing.","kind":"RESEARCH_INTERPRETATION","evidenceRefs":["solar","testimony"]},"industryBefore":"UNKNOWN","relevantCompanies":"UNKNOWN","publiclyObservableInterests":"UNKNOWN","lobbying":"UNKNOWN","statedGoal":"UNKNOWN","expectedBeneficiary":{"value":"Solyndra as the named funding recipient; durable profitability was a hypothesis.","kind":"RESEARCH_INTERPRETATION","evidenceRefs":["solar","testimony"]},"actualBeneficiary":{"value":"A financed plant did not survive; no durable manufacturer rent demonstrated.","kind":"OBSERVED_ECONOMICS","evidenceRefs":["solar","testimony"]},"expectedLoser":"UNKNOWN","actualLoser":{"value":"Solyndra operations ceased; government recovery losses reported later.","kind":"OBSERVED_ECONOMICS","evidenceRefs":["solar","testimony"]},"directBeneficiary":"UNKNOWN","secondOrderBeneficiary":{"value":"Workers and suppliers received over $200m during the final financing interval; payments are not evidence of supplier profit.","kind":"OBSERVED_ECONOMICS","evidenceRefs":["solar","testimony"]},"bottleneckBeneficiary":"UNKNOWN","transmission":{"value":"Funding expanded capacity but competition and cost structure undermined survival.","kind":"RESEARCH_INTERPRETATION","evidenceRefs":["solar","testimony"]},"capitalRequirements":"UNKNOWN","concentration":"UNKNOWN","entryBarrierChange":"UNKNOWN","revenueOutcome":{"value":"Revenue growth from $100m to $140m did not prevent failure.","kind":"OBSERVED_ECONOMICS","evidenceRefs":["solar","testimony"]},"marginOutcome":"UNKNOWN","backlogOutcome":"UNKNOWN","marketShareOutcome":"UNKNOWN","fcfOutcome":"UNKNOWN","roicOutcome":"UNKNOWN","valuationOutcome":"UNKNOWN","timeLag":"UNKNOWN","duration":{"value":"Bankruptcy roughly two years after guarantee.","kind":"RESEARCH_INTERPRETATION","evidenceRefs":["solar","testimony"]},"competedAway":"UNKNOWN","reversed":"UNKNOWN","politicalDestruction":"UNKNOWN","wrongBeneficiary":"UNKNOWN","lessons":{"value":"Volume, subsidy and financing cannot substitute for sustainable cost and cash economics.","kind":"RESEARCH_INTERPRETATION","evidenceRefs":["solar","testimony"]}},"structure":{"mechanism":{"value":"CAPACITY_SUPPORT","kind":"RESEARCH_INTERPRETATION","evidenceRefs":["solar","testimony"]},"industryStructure":{"value":"MANUFACTURING","kind":"RESEARCH_INTERPRETATION","evidenceRefs":["solar","testimony"]},"concentration":"UNKNOWN","bottleneck":"UNKNOWN","capitalIntensity":{"value":"HIGH","kind":"RESEARCH_INTERPRETATION","evidenceRefs":["solar","testimony"]},"complianceCost":"UNKNOWN","certification":"UNKNOWN","supplyElasticity":"UNKNOWN","durability":"UNKNOWN","politicalContext":{"value":"REVERSIBLE","kind":"RESEARCH_INTERPRETATION","evidenceRefs":["solar","testimony"]},"implementation":{"value":"OPERATING","kind":"RESEARCH_INTERPRETATION","evidenceRefs":["solar","testimony"]},"capture":"UNKNOWN"},"patternIds":["pattern-B","pattern-K","pattern-M"],"result":"REGULATORY_FALSE_POSITIVE","falsePositiveReason":"Funded capacity and revenue growth failed to produce survival; subsidy-recipient-as-durable-winner hypothesis rejected."},"hash":"d30622b0835ce5e784f98fa0a56543018c4522447766bbe8d9dadbefb4fa4005"}
