{"sequence":1,"previousHash":null,"payload":{"schemaVersion":"argus.regulatory-history/1","id":"history-rail-1980","timestamp":"2026-09-04T16:52:46.739Z","evidenceCutoff":"2026-09-04T16:52:43.405Z","mode":"CURRENT_REVIEW","sources":[{"id":"rail","url":"https://www.gao.gov/assets/a252479.html","publishedAt":"2006-10-06T23:59:59.999Z","observedAt":"2026-09-04T16:52:43.405Z","precision":"DAY_END_BOUND","authority":"GOVERNMENT","category":"OUTCOME","edition":"DATED_DOCUMENT","locator":"Reviewed primary publication; curated factual excerpt, not original HTML fingerprint","text":"GAO reports generally increasing railroad return on investment since 1980, cost reductions and stronger financial health after Staggers deregulation. Many shippers benefited, while captive routes raised competition concerns. ROI is an STB metric, not independently calculated company ROIC.","contentHash":"82e326b6168e6714c85f89142b6940c4f9c29f12fbf1d936bccc81983d9bb50c"}],"fields":{"historicalEvent":{"value":"Staggers freight-rail deregulation","kind":"RESEARCH_INTERPRETATION","evidenceRefs":["rail"]},"jurisdiction":{"value":"United States","kind":"RESEARCH_INTERPRETATION","evidenceRefs":["rail"]},"date":{"value":"1980","kind":"RESEARCH_INTERPRETATION","evidenceRefs":["rail"]},"policyMechanism":{"value":"Pricing and contracting discretion with residual captive-shipper protection.","kind":"RESEARCH_INTERPRETATION","evidenceRefs":["rail"]},"industryBefore":{"value":"Regulated capital-intensive networks in weak financial condition.","kind":"RESEARCH_INTERPRETATION","evidenceRefs":["rail"]},"relevantCompanies":"UNKNOWN","publiclyObservableInterests":"UNKNOWN","lobbying":"UNKNOWN","statedGoal":"UNKNOWN","expectedBeneficiary":"UNKNOWN","actualBeneficiary":{"value":"Freight rail industry financial health improved; some shippers also benefited.","kind":"OBSERVED_ECONOMICS","evidenceRefs":["rail"]},"expectedLoser":"UNKNOWN","actualLoser":{"value":"Captive shippers faced competition concerns; not every ship