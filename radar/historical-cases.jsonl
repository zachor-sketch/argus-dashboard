{"sequence":2,"previousHash":"25753335ef21d2a78075eae70c753bb424208cbac2785d9abd919a657ad91ab1","payload":{"schemaVersion":"argus.regulatory-history/1","id":"history-steel-2018","timestamp":"2026-09-04T16:52:46.952Z","evidenceCutoff":"2026-09-04T16:52:43.405Z","mode":"CURRENT_REVIEW","sources":[{"id":"steel","url":"https://www.usitc.gov/press_room/news_release/2023/er0315_63679.htm","publishedAt":"2023-03-15T23:59:59.999Z","observedAt":"2026-09-04T16:52:43.405Z","precision":"DAY_END_BOUND","authority":"GOVERNMENT","category":"OUTCOME","edition":"DATED_DOCUMENT","locator":"Reviewed primary publication; curated factual excerpt, not original HTML fingerprint","text":"USITC estimated 2018-2021 tariff effects: domestic steel output +1.9% and prices +2.4%; downstream production $3.5bn lower in 2021. These are modeled policy effects, not firm-level FCF or ROIC.","contentHash":"d5d34a3e7f3911a6e10255bc738a6c5f069fccc4e574f8895a00257d806fcbcd"}],"fields":{"historicalEvent":{"value":"Section 232 steel and aluminum tariffs","kind":"RESEARCH_INTERPRETATION","evidenceRefs":["steel"]},"jurisdiction":{"value":"United States","kind":"RESEARCH_INTERPRETATION","evidenceRefs":["steel"]},"date":{"value":"2018","kind":"RESEARCH_INTERPRETATION","evidenceRefs":["steel"]},"policyMechanism":{"value":"Import tariffs increased domestic input prices.","kind":"RESEARCH_INTERPRETATION","evidenceRefs":["steel"]},"industryBefore":"UNKNOWN","relevantCompanies":"UNKNOWN","publiclyObservableInterests":"UNKNOWN","lobbying":"UNKNOWN","statedGoal":"UNKNOWN","expectedBeneficiary":"UNKNOWN","actualBeneficiary":{"value":"Domestic steel producers: modeled positive output and price effects.","kind":"OBSERVED_ECONOMICS","evidenceRefs":["steel"]},"expectedLoser":"UNKNOWN","actualLoser":{"value":"Downstream input users: modeled production loss.","kind":"OBSERVED_ECONOMICS","evidenceRefs":["steel"]},"directBeneficiary":"UNKNOWN","secondOrderBeneficiary":{"value":"Value moved upstream to protected steel rather than remaining with downstream manufacturers; supplier-level excess margins UNKNOWN.","kind":"OBSERVED_ECONOMICS","evidenceRefs":["steel"]},"bottleneckBeneficiary":"UNKNOWN","transmission":{"value":"Protected inputs gain pricing; downstream manufacturers pay higher costs.","kind":"RESEARCH_INTERPRETATION","evidenceRefs":["steel"]},"capitalRequirements":"UNKNOWN","concentration":"UNKNOWN","entryBarrierChange":"UNKNOWN","revenueOutcome":{"value":"Steel production value $1.3bn higher in 2021; not company revenue attribution.","kind":"OBSERVED_ECONOMICS","evidenceRefs":["steel"]},"marginOutcome":"UNKNOWN","backlogOutcome":"UNKNOWN","marketShareOutcome":"UNKNOWN","fcfOutcome":"UNKNOWN","roicOutcome":"UNKNOWN","valuationOutcome":"UNKNOWN","timeLag":{"value":"Study covers 2018-2021.","kind":"RESEARCH_INTERPRETATION","evidenceRefs":["steel"]},"duration":"UNKNOWN","competedAway":"UNKNOWN","reversed":"UNKNOWN","politicalDestruction":"UNKNOWN","wrongBeneficiary":"UNKNOWN","lessons":{"value":"Observed price/output transfer is a limited success; FCF, ROIC and persistence remain UNKNOWN.","kind":"RESEARCH_INTERPRETATION","evidenceRefs":["steel"]}},"structure":{"mechanism":{"value":"INPUT_PROTECTION","kind":"RESEARCH_INTERPRETATION","evidenceRefs":["steel"]},"industryStructure":{"value":"MANUFACTURING","kind":"RESEARCH_INTERPRETATION","evidenceRefs":["steel"]},"concentration":"UNKNOWN","bottleneck":"UNKNOWN","capitalIntensity":{"value":"HIGH","kind":"RESEARCH_INTERPRETATION","evidenceRefs":["steel"]},"complianceCost":{"value":"COST_TRANSFER","kind":"RESEARCH_INTERPRETATION","evidenceRefs":["steel"]},"certification":"UNKNOWN","supplyElasticity":"UNKNOWN","durability":"UNKNOWN","politicalContext":{"value":"REVERSIBLE","kind":"RESEARCH_INTERPRETATION","evidenceRefs":["steel"]},"implementation":{"value":"OPERATING","kind":"RESEARCH_INTERPRETATION","evidenceRefs":["steel"]},"capture":"UNKNOWN"},"patternIds":["pattern-I","pattern-N"],"result":"SUCCESS_OBSERVED","falsePositiveReason":"UNKN